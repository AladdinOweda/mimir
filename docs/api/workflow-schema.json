{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimir.local/schemas/workflow-schema.json",
  "title": "MimirWorkflowDefinition",
  "type": "object",
  "required": ["id", "version", "nodes", "edges"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "title": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["agent", "tool", "human_approval", "condition", "transform"] },
          "capability": { "type": "string" },
          "blockId": { "type": "string" },
          "config": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "condition": { "type": "string" }
        }
      }
    },
    "triggers": { "type": "array", "items": { "type": "string" } },
    "policyRef": { "type": "string" },
    "runtimeRequirements": {
      "type": "array",
      "items": { "type": "string" },
      "description": "optional adapters e.g. langgraph — never required for native path"
    }
  },
  "additionalProperties": false
}
