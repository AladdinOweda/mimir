CREATE TABLE workflow_run (
  run_id TEXT NOT NULL PRIMARY KEY,
  workflow_id TEXT NOT NULL,
  workflow_version TEXT NOT NULL,
  status TEXT NOT NULL,
  current_node_id TEXT,
  node_order_csv TEXT NOT NULL,
  index_pos INTEGER NOT NULL DEFAULT 0,
  completed_csv TEXT NOT NULL DEFAULT '',
  checkpoints_json TEXT NOT NULL DEFAULT '[]',
  idempotency_key TEXT NOT NULL DEFAULT '',
  updated_at_epoch_ms INTEGER NOT NULL
);

CREATE INDEX workflow_run_workflow_id ON workflow_run(workflow_id);
CREATE INDEX workflow_run_idempotency ON workflow_run(workflow_id, idempotency_key);

selectById:
SELECT * FROM workflow_run WHERE run_id = ?;

selectByWorkflow:
SELECT * FROM workflow_run WHERE workflow_id = ?;

upsert:
INSERT OR REPLACE INTO workflow_run(
  run_id, workflow_id, workflow_version, status, current_node_id,
  node_order_csv, index_pos, completed_csv, checkpoints_json, idempotency_key, updated_at_epoch_ms
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM workflow_run WHERE run_id = ?;
